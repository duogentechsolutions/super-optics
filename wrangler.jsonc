{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "super-optics",
  "compatibility_date": "2026-09-23",
  // Build the Vite app before every deploy (dist/ is gitignored, so CI starts without it)
  "build": {
    "command": "npm run build"
  },
  "assets": {
    // Vite build output
    "directory": "./dist",
    // Serve index.html for unknown routes so react-router can handle client-side routing
    "not_found_handling": "single-page-application"
  }
}
