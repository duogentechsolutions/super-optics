{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "opticare-demo",
  "compatibility_date": "2026-09-23",
  "assets": {
    // Vite build output
    "directory": "./dist",
    // Serve index.html for unknown routes so react-router can handle client-side routing
    "not_found_handling": "single-page-application"
  }
}
